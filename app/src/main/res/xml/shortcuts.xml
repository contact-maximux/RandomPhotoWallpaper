<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="night_mode"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_night_short"
        android:shortcutLongLabel="@string/shortcut_night_long">

        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="notepad.autowall"
            android:targetClass="notepad.autowall.MainActivity">

            <extra
                android:name="OPEN_NIGHT_MODE"
                android:value="true" />

        </intent>

    </shortcut>

</shortcuts>